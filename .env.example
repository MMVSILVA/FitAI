# Environment variables example
# Copy this file to .env and fill in the values

GEMINI_API_KEY=your_gemini_api_key

# Stripe Configuration
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID_PRO=price_1TOm2UCVEgijuso4yuRkIuoC
STRIPE_PRICE_ID_PREMIUM=price_1TOm3CCVEgijuso4h63UP1b3
STRIPE_PRICE_ID_PROFISSIONAL=price_1TRe4MCVEgijuso4xhL6gSpn

# Stripe Payment Links (Direct)
VITE_STRIPE_LINK_PRO=https://buy.stripe.com/your_pro_link
VITE_STRIPE_LINK_PREMIUM=https://buy.stripe.com/your_premium_link
VITE_STRIPE_LINK_PROFISSIONAL=https://buy.stripe.com/your_profissional_link

# Client URL (if different from host detected automatically)
# CLIENT_URL=https://your-domain.com

# Unsplash (optional for placeholder images)
UNSPLASH_ACCESS_KEY=your_unsplash_access_key

# Google Maps (for Gym Locator)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_api_key
