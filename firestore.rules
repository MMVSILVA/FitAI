rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // ==========================================
    // 1. PUBLIC SYSTEM RULES (MUST BE TOP FOR PRECEDENCE)
    // ==========================================
    match /system/{configId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /test/connection {
      allow read: if true;
    }

    // ==========================================
    // 2. GLOBAL HELPERS & PROTECTIONS
    // ==========================================
    
    function isSignedIn() {
      return request.auth != null;
    }

    function isEmailVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isAdmin() {
      return isSignedIn() && 
             (
               (request.auth.token.email != null && (
                 request.auth.token.email == 'vinidoctor@gmail.com' ||
                 request.auth.token.email.lower() == 'vinidoctor@gmail.com'
               )) ||
               exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
               (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
             );
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }


    // ==========================================
    // 2. ENTITY VALIDATION HELPERS
    // ==========================================

    function isValidUserProfile(data) {
      return data.uid == request.auth.uid &&
             data.email is string && data.email.size() <= 256 &&
             data.displayName is string && data.displayName.size() <= 100 &&
             data.role in ['user', 'trainer', 'nutritionist', 'admin'] &&
             data.planType in ['FREE', 'PRO', 'PREMIUM', 'PROFISSIONAL'] &&
             (data.weight == null || data.weight is number) &&
             (data.height == null || data.height is number) &&
             (data.showInRanking == null || data.showInRanking is bool);
    }

    function isValidWorkout(data) {
      return data.userId is string && data.userId.size() <= 128 &&
             data.createdBy in ['IA', 'Trainer', 'System'] &&
             data.days is list && data.days.size() <= 7;
    }

    function isValidProgress(data) {
      return data.userId == request.auth.uid &&
             data.weight is number &&
             data.photos is list && data.photos.size() <= 10;
    }

    function isValidMessage(data) {
      return data.fromId == request.auth.uid &&
             data.toId is string && data.toId.size() <= 128 &&
             data.text is string && data.text.size() <= 5000;
    }

    function isValidExerciseProgress(data) {
      return data.userId == request.auth.uid &&
             data.exerciseName is string && data.exerciseName.size() <= 200 &&
             data.weight is number &&
             data.reps is number &&
             data.date is string;
    }

    function isPremium() {
      return isSignedIn() && exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.planType in ['PRO', 'PREMIUM', 'PROFISSIONAL'];
    }

    // ==========================================
    // 4. COLLECTION RULES
    // ==========================================

    // Exercise Progress
    match /exercise_progress/{progressId} {
      allow read, list: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() || 
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedTrainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedNutritionistId == request.auth.uid
      );
      allow create: if isOwner(incoming().userId) && isValidExerciseProgress(incoming()) && isPremium();
      allow delete: if isOwner(resource.data.userId) || isAdmin();
    }

    // User Profiles
    match /users/{userId} {
      allow read: if isSignedIn(); // Basic read for search and linking
      
      allow list: if isSignedIn() && (isOwner(userId) || isAdmin() || resource.data.showInRanking == true);
      
      allow create: if isOwner(userId);
      
      allow update: if (isAdmin()) || (
        isOwner(userId) && 
        // Protect sensitive fields from self-alteration
        incoming().role == existing().role &&
        incoming().planType == existing().planType &&
        incoming().email == existing().email &&
        incoming().uid == existing().uid &&
        // Allow updating preferred professional IDs and other fields
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'weight', 'height', 'objective', 'fitnessLevel', 
          'phone', 'photoURL', 'updatedAt', 'showInRanking', 'lastSeen', 'planGenerationsLeft',
          'workoutPreferences', 'dietPreferences', 'gender', 'age', 'intensity',
          'linkedTrainerId', 'linkedNutritionistId', 'trainerId', 'nutritionistId',
          'workout', 'plan', 'profile', 'progress', 'completedExercises',
          'clients', 'trainerClients', 'nutritionistClients',
          'adherenceLogs', 'points', 'level', 'streak', 'checkInDates', 'badges', 'theme',
          'targetWeight', 'weightHistory', 'hydration', 'dailyWaterLogs', 'weightEntries',
          'joinedChallenges', 'medals', 'workoutReminder', 'completedWorkouts'
        ])
      ) || (
        // Allow professionals to link themselves to a user
        isSignedIn() && (
          (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['trainer', 'nutritionist']) &&
          incoming().diff(existing()).affectedKeys().hasOnly(['linkedTrainerId', 'trainerId', 'linkedNutritionistId', 'nutritionistId', 'clients', 'trainerClients', 'nutritionistClients'])
        )
      );
      
      allow delete: if isAdmin();
    }

    // Clinical Records
    match /clinical_records/{recordId} {
      allow read: if isSignedIn() && (
        resource.data.clientId == request.auth.uid || 
        resource.data.professionalId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isSignedIn() && (
        incoming().professionalId == request.auth.uid || isAdmin()
      );
      allow update, delete: if isAdmin() || (isSignedIn() && resource.data.professionalId == request.auth.uid);
    }

    // Community Messages (Moderated)
    match /community_messages/{messageId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && incoming().fromId == request.auth.uid;
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.fromId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt', 'reactions'])) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if isSignedIn() && (resource.data.fromId == request.auth.uid || isAdmin());
    }

    // Reports (System Security)
    match /reports/{reportId} {
      allow create: if isSignedIn();
      allow read, write: if isAdmin();
    }

    // Trainers
    match /trainers/{trainerId} {
      allow read: if isSignedIn();
      allow write: if isAdmin() || isOwner(trainerId);
    }

    // Workouts
    match /workouts/{workoutId} {
      allow read: if isSignedIn() && (
        resource.data.userId == request.auth.uid || 
        isAdmin() ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'trainer')
      );
      
      allow create: if isSignedIn() && 
                      isValidWorkout(incoming()) && (
                        incoming().userId == request.auth.uid || isAdmin()
                      );
                      
      allow update: if isSignedIn() && 
                      isValidWorkout(incoming()) && (
                        (resource.data.userId == request.auth.uid && incoming().userId == resource.data.userId) || 
                        isAdmin()
                      ) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['days', 'updatedAt', 'structure', 'focus', 'progression', 'strategies']);
    }

    // Progress
    match /progress/{progressId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedTrainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedNutritionistId == request.auth.uid
      );
      allow create: if isOwner(incoming().userId) && isValidProgress(incoming());
      allow update: if isOwner(resource.data.userId) && isValidProgress(incoming()) &&
                      incoming().diff(existing()).affectedKeys().hasOnly(['weight', 'bodyFat', 'photos', 'date', 'measurements']);
    }

    // Messages (Direct 1-on-1 Chat)
    match /messages/{messageId} {
      allow read: if isSignedIn() && (
        resource.data.fromId == request.auth.uid || 
        resource.data.toId == request.auth.uid || 
        isAdmin()
      );
      allow create: if isOwner(incoming().fromId) && isValidMessage(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (resource.data.fromId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['text', 'isEdited', 'editedAt', 'reactions'])) ||
        incoming().diff(existing()).affectedKeys().hasOnly(['reactions'])
      );
      allow delete: if isSignedIn() && (resource.data.fromId == request.auth.uid || isAdmin());
    }

    // Weight History
    match /weight_history/{entryId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedTrainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedNutritionistId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Workout Sessions
    match /workout_sessions/{sessionId} {
      allow read, list: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedTrainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedNutritionistId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Hydration Logs
    match /hydration_logs/{logId} {
      allow read: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedTrainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedNutritionistId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Daily Check-ins
    match /daily_checkins/{checkinId} {
      allow read, list: if isSignedIn() && (
        isOwner(resource.data.userId) || 
        isAdmin() ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedTrainerId == request.auth.uid ||
        get(/databases/$(database)/documents/users/$(resource.data.userId)).data.linkedNutritionistId == request.auth.uid
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Default Deny (Globally inside the main block)
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
