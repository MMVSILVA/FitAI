{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "Comprehensive user data for SaaS",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "email": { "type": "string" },
        "displayName": { "type": "string" },
        "role": { "type": "string", "enum": ["user", "premium_user", "trainer", "admin"] },
        "planType": { "type": "string", "enum": ["FREE", "PRO", "PREMIUM", "ELITE"] },
        "weight": { "type": "number" },
        "height": { "type": "number" },
        "objective": { "type": "string" },
        "fitnessLevel": { "type": "string" },
        "trainerId": { "type": "string" },
        "stripeCustomerId": { "type": "string" },
        "isPremium": { "type": "boolean" },
        "points": { "type": "number" },
        "level": { "type": "number" },
        "streak": { "type": "number" },
        "checkInDates": { "type": "array", "items": { "type": "string" } },
        "badges": { "type": "array", "items": { "type": "string" } },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["uid", "email", "role"]
    },
    "Trainer": {
      "title": "Trainer",
      "description": "Professional trainer data",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "clientsIds": { "type": "array", "items": { "type": "string" } }
      }
    },
    "Workout": {
      "title": "Workout",
      "description": "Training plan structure",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "createdBy": { "type": "string", "enum": ["IA", "Trainer"] },
        "structure": { "type": "object" },
        "createdAt": { "type": "string", "format": "date-time" }
      }
    },
    "Progress": {
      "title": "Progress",
      "description": "User physical evolution records",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "weight": { "type": "number" },
        "bodyFat": { "type": "number" },
        "photos": { "type": "array", "items": { "type": "string" } },
        "date": { "type": "string", "format": "date-time" }
      }
    },
    "ExerciseProgress": {
      "title": "ExerciseProgress",
      "description": "Historical performance data for specific exercises",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "exerciseName": { "type": "string" },
        "weight": { "type": "number" },
        "reps": { "type": "number" },
        "date": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "exerciseName", "weight", "date"]
    },
    "Message": {
      "title": "Message",
      "description": "Chat message data",
      "type": "object",
      "properties": {
        "fromId": { "type": "string" },
        "toId": { "type": "string" },
        "text": { "type": "string" },
        "timestamp": { "type": "string", "format": "date-time" }
      }
    },
    "SystemConfig": {
      "title": "SystemConfig",
      "description": "Global application settings and versioning",
      "type": "object",
      "properties": {
        "latestVersion": { "type": "string" },
        "updateMessage": { "type": "string" },
        "maintenanceMode": { "type": "boolean" }
      }
    },
    "DailyCheckin": {
      "title": "DailyCheckin",
      "description": "User daily health, sleep, weight and nutrition check-in entry",
      "type": "object",
      "properties": {
        "userId": { "type": "string" },
        "date": { "type": "string" },
        "weight": { "type": "number" },
        "sleepHours": { "type": "number" },
        "sleepQuality": { "type": "number" },
        "energyLevel": { "type": "number" },
        "waterIntakeMl": { "type": "number" },
        "caloriesConsumed": { "type": "number" },
        "notes": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" }
      },
      "required": ["userId", "date", "createdAt"]
    }
  },
  "firestore": {
    "/system/{configId}": {
      "schema": { "$ref": "SystemConfig" },
      "description": "Global app configuration and versioning"
    },
    "/daily_checkins/{checkinId}": {
      "schema": { "$ref": "DailyCheckin" },
      "description": "Daily check-in and readiness logs"
    },
    "/users/{userId}": {
      "schema": { "$ref": "UserProfile" },
      "description": "Main user records"
    },
    "/trainers/{trainerId}": {
      "schema": { "$ref": "Trainer" },
      "description": "Trainer profiles"
    },
    "/workouts/{workoutId}": {
      "schema": { "$ref": "Workout" },
      "description": "Generated or assigned workout plans"
    },
    "/progress/{progressId}": {
      "schema": { "$ref": "Progress" },
      "description": "Historical progress data"
    },
    "/exercise_progress/{progressId}": {
      "schema": { "$ref": "ExerciseProgress" },
      "description": "Historical exercise performance data"
    },
    "/messages/{messageId}": {
      "schema": { "$ref": "Message" },
      "description": "Real-time communication"
    }
  }
}
